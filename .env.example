# Firebase web app configuration (Firebase console -> Project settings -> Your apps)
# These values are safe to expose publicly; access is controlled by Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Point the client at the local Firebase Emulator Suite instead of production.
VITE_USE_EMULATORS=false

# Shown in the UI (sidebar, page title).
VITE_APP_NAME=Acme Studio
