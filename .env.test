# Dummy configuration used by the authenticated Playwright suite.
# Everything points at the local emulator suite; no real project is involved.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-rfb-rules.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-rfb-rules
VITE_FIREBASE_STORAGE_BUCKET=demo-rfb-rules.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:demo
VITE_USE_EMULATORS=true
VITE_APP_NAME=Northstar
